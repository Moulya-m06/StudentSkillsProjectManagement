{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Java",
      "type": "shell",
      "command": "javac",
      "args": [
        "-d",
        "out",
        "src/*.java"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$javac"
    },
    {
      "label": "Run App",
      "type": "shell",
      "command": "java",
      "args": [
        "-cp",
        "out;lib/mysql-connector-j.jar",
        "Main"
      ],
      "dependsOn": "Compile Java",
      "problemMatcher": []
    }
  ]
}
